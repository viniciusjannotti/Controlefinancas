rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Contas (famílias) ──────────────────────────────────────────────────────
    // Qualquer usuário autenticado pode criar uma conta
    // Somente membros da conta podem ler e atualizar
    match /accounts/{accountId} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      allow delete: if false; // Nunca deletar via cliente
    }

    // ── Perfis de usuário ──────────────────────────────────────────────────────
    // Cada usuário só pode ler e escrever seu próprio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Transações ─────────────────────────────────────────────────────────────
    // Somente membros da conta podem ler/escrever transações
    match /accounts/{accountId}/transactions/{transactionId} {
      allow read, write: if request.auth != null
                         && exists(/databases/$(database)/documents/accounts/$(accountId))
                         && request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.members;
    }

    // ── Categorias ─────────────────────────────────────────────────────────────
    match /accounts/{accountId}/categories/{categoryId} {
      allow read, write: if request.auth != null
                         && exists(/databases/$(database)/documents/accounts/$(accountId))
                         && request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.members;
    }

    // ── Orçamentos ─────────────────────────────────────────────────────────────
    match /accounts/{accountId}/budgets/{budgetId} {
      allow read, write: if request.auth != null
                         && exists(/databases/$(database)/documents/accounts/$(accountId))
                         && request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.members;
    }
  }
}
