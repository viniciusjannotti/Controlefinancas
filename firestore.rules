rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: usuário autenticado é membro da conta ──────────────────────────
    function isMember(accountId) {
      return request.auth != null
             && accountId != null
             && exists(/databases/$(database)/documents/accounts/$(accountId))
             && request.auth.uid in get(/databases/$(database)/documents/accounts/$(accountId)).data.members;
    }

    // ── Contas (famílias) ──────────────────────────────────────────────────────
    // Qualquer usuário autenticado pode criar uma conta
    // Somente membros da conta podem ler e atualizar
    match /accounts/{accountId} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;

      allow read, update: if isMember(accountId);

      allow delete: if false; // Nunca deletar via cliente
    }

    // ── Perfis de usuário ────────────────────────────────────────────────────────
    // Cada usuário só pode escrever o próprio perfil.
    // Leitura: o próprio usuário, ou qualquer membro da mesma conta (necessário
    // para exibir os nomes reais dos membros da conta em Ganhos/Gastos/Investimentos).
    match /users/{userId} {
      allow write: if request.auth != null
                  && request.auth.uid == userId;

      allow read: if request.auth != null
                 && (request.auth.uid == userId || isMember(resource.data.accountId));
    }

    // ── Coleções financeiras (ganhos, gastos, investimentos, proventos, lembretes) ─
    // Documentos guardam accountId como campo; acesso liberado a membros da conta
    match /expenses/{docId} {
      allow read, update, delete: if isMember(resource.data.accountId);
      allow create: if isMember(request.resource.data.accountId);
    }

    match /earnings/{docId} {
      allow read, update, delete: if isMember(resource.data.accountId);
      allow create: if isMember(request.resource.data.accountId);
    }

    match /investments/{docId} {
      allow read, update, delete: if isMember(resource.data.accountId);
      allow create: if isMember(request.resource.data.accountId);
    }

    match /dividends/{docId} {
      allow read, update, delete: if isMember(resource.data.accountId);
      allow create: if isMember(request.resource.data.accountId);
    }

    match /reminders/{docId} {
      allow read, update, delete: if isMember(resource.data.accountId);
      allow create: if isMember(request.resource.data.accountId);
    }

    // ── Clientes (Vinícius / Maria Cecília) ─────────────────────────────────────
    match /vinicius_clients/{docId} {
      allow read, update, delete: if isMember(resource.data.accountId);
      allow create: if isMember(request.resource.data.accountId);
    }

    match /cecilia_clients/{docId} {
      allow read, update, delete: if isMember(resource.data.accountId);
      allow create: if isMember(request.resource.data.accountId);
    }

    // ── Configurações e dados de jogo ────────────────────────────────────────────
    // Documentos usam o próprio accountId como id do documento
    match /settings/{accountId} {
      allow read, write: if isMember(accountId);
    }

    match /userGameData/{accountId} {
      allow read, write: if isMember(accountId);
    }
  }
}
